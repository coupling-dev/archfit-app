#!/usr/bin/env bash
# Fake docker for deploy.bats. It logs each call to $FAKE_LOG; a push makes the image exist for the fake gcloud.
# Like the real one, it writes progress to stdout.
set -euo pipefail

printf 'docker %s\n' "$*" >>"$FAKE_LOG"
printf '%s: progress line\n' "$1"
if [[ $1 == push ]]; then
	touch "$FAKE_STATE/pushed"
	printf 'latest: digest: %s size: 1234\n' "$FAKE_DIGEST"
fi
