# Archfit App configuration. Secrets are FILE PATHS, never values: a PEM or token
# in an environment variable is a secret in every process listing.
# The binary does not read this file; export the variables yourself.

ARCHFIT_ADDR=:8080
# Listen address and the public base URL. The base URL is also the OIDC audience
# the Action requests its token for, compared byte for byte; it must not end in '/'.
ARCHFIT_BASE_URL=

# GitHub App credentials.
ARCHFIT_GITHUB_APP_ID=
ARCHFIT_GITHUB_PRIVATE_KEY_FILE=
ARCHFIT_GITHUB_WEBHOOK_SECRET_FILE=
ARCHFIT_GITHUB_OAUTH_CLIENT_ID=
ARCHFIT_GITHUB_OAUTH_SECRET_FILE=

# 32-byte key for the encrypted session cookie.
ARCHFIT_COOKIE_KEY_FILE=

# Bearer token for POST /internal/sweep and POST /internal/grants.
ARCHFIT_OPERATOR_TOKEN_FILE=

# Optional. Empty disables managed LLM assistance.
ARCHFIT_ANTHROPIC_KEY_FILE=

# Platform drivers. Only these values exist until docs/tech-stack.md picks others.
ARCHFIT_STORE=memory
ARCHFIT_SANDBOX=none
