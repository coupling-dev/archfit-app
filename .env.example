# GitHub App credentials. The private key is a file path, not the key itself:
# a PEM in an environment variable is a PEM in every process listing.
ARCHFIT_APP_ID=
ARCHFIT_APP_PRIVATE_KEY_FILE=
ARCHFIT_WEBHOOK_SECRET=

# Public base URL webhooks are delivered to.
ARCHFIT_BASE_URL=

# OIDC audience the action requests its token for. Must match the action input.
ARCHFIT_OIDC_AUDIENCE=archfit-app

# Reporter listen address.
ARCHFIT_ADDR=:8080
