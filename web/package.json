{
  "name": "archfit-web",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && vite build",
    "check": "svelte-check --fail-on-warnings",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "smoke": "playwright test",
    "docs:shots": "ARCHFIT_DOCS_SHOTS=1 playwright test -g @docs",
    "ci": "npm run check && npm run lint && npm test && npm run build && npm run size && npm run smoke",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.9",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "playwright-core": "1.65.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "elkjs": "0.12.1"
  }
}
