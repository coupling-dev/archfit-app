{
  "name": "archfit-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && vite build",
    "check": "svelte-check --fail-on-warnings",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "smoke": "playwright test",
    "ci": "npm run check && npm run lint && npm test && npm run build && npm run size && npm run smoke",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@xyflow/svelte": "1.7.0",
    "elkjs": "0.12.0"
  }
}
