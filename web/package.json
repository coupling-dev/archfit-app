{
  "name": "archfit-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && vite build",
    "check": "svelte-check --fail-on-warnings",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "smoke": "playwright test",
    "ci": "npm run check && npm test && npm run build && npm run size && npm run smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.1",
    "playwright-core": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
