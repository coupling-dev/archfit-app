{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archfit.dev/schemas/report-envelope.v1.json",
  "title": "archfit report envelope v1",
  "description": "What the producer states about one uploaded payload. Every field is self-reported. The decoder is stricter than this document in three ways a schema cannot express: integers carry no fraction or exponent and are bounded (run_id to 64 bits, the others to 32), and the raw envelope is at most 8192 bytes with no duplicate keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repository",
    "event",
    "pull_request",
    "head_sha",
    "base_sha",
    "merge_base_sha",
    "analyzed_sha",
    "integration",
    "run_id",
    "run_attempt",
    "engine_version",
    "image_digest",
    "platform",
    "payload_digest",
    "baseline_digest",
    "labels_digest"
  ],
  "properties": {
    "schema_version": { "const": "archfit.report-envelope.v1" },
    "kind": { "enum": ["report", "discovery", "baseline", "reanchor"] },
    "repository": {
      "type": "string",
      "description": "owner/name",
      "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
    },
    "event": {
      "type": "string",
      "description": "The workflow trigger. Format only: an unsupported trigger is an outcome, not a parse error.",
      "pattern": "^[a-z_]{1,64}$"
    },
    "pull_request": {
      "type": "integer",
      "description": "Pull request number; 0 unless event is pull_request.",
      "minimum": 0
    },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_sha": {
      "type": "string",
      "description": "Empty unless event is pull_request.",
      "pattern": "^([0-9a-f]{40})?$"
    },
    "merge_base_sha": {
      "type": "string",
      "description": "Empty unless event is pull_request.",
      "pattern": "^([0-9a-f]{40})?$"
    },
    "analyzed_sha": {
      "type": "string",
      "description": "The commit the engine measured: the pull request's test merge commit when integration is merged, else head_sha.",
      "pattern": "^[0-9a-f]{40}$"
    },
    "integration": {
      "enum": ["", "merged", "conflicts"],
      "description": "How a pull request lands: merged (analyzed_sha is the test merge commit of head_sha into base_sha) or conflicts (the event reports a conflict; analyzed_sha is head_sha). Empty unless event is pull_request."
    },
    "run_id": { "type": "integer", "minimum": 1 },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "engine_version": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$" },
    "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9]+/[a-z0-9]+(/[a-z0-9]+)?$",
      "maxLength": 32
    },
    "payload_digest": {
      "type": "string",
      "description": "sha256:<hex> of the exact payload bytes.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baseline_digest": {
      "type": "string",
      "description": "Bare hex SHA-256 of the baseline file the engine loaded; empty when it loaded none. For kind reanchor: the protected baseline blob at head_sha that the engine read; required.",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "labels_digest": {
      "type": "string",
      "description": "Bare hex SHA-256 of the labels file the engine loaded; empty when it loaded none.",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "policy_change": {
      "type": "object",
      "description": "Optional. The engine's classification of the pull request's .archfit.yaml change (archfit config compare, policy_change), head file against the base tip's. Absent when the pull request does not change the policy, the change orders nothing, the engine does not classify, or the object does not fit the envelope. The list items are the engine's; this schema checks only the lists.",
      "additionalProperties": false,
      "required": ["direction", "rules_removed", "rules_loosened", "waivers_added", "allowlists_widened", "coverage_lost", "declarations_changed", "rules_added", "rules_tightened", "waivers_removed", "allowlists_narrowed", "coverage_gained"],
      "properties": {
          "direction": { "enum": ["tightening", "loosening", "mixed"] },
          "rules_removed": { "type": "array", "items": { "type": "object" } },
          "rules_loosened": { "type": "array", "items": { "type": "object" } },
          "waivers_added": { "type": "array", "items": { "type": "object" } },
          "allowlists_widened": { "type": "array", "items": { "type": "object" } },
          "coverage_lost": { "type": "array", "items": { "type": "object" } },
          "declarations_changed": { "type": "array", "items": { "type": "object" } },
          "rules_added": { "type": "array", "items": { "type": "object" } },
          "rules_tightened": { "type": "array", "items": { "type": "object" } },
          "waivers_removed": { "type": "array", "items": { "type": "object" } },
          "allowlists_narrowed": { "type": "array", "items": { "type": "object" } },
          "coverage_gained": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event": { "const": "pull_request" } },
        "required": ["event"]
      },
      "then": {
        "properties": {
          "pull_request": { "minimum": 1 },
          "base_sha": { "pattern": "^[0-9a-f]{40}$" },
          "merge_base_sha": { "pattern": "^[0-9a-f]{40}$" },
          "integration": { "enum": ["merged", "conflicts"] }
        }
      },
      "else": {
        "properties": {
          "pull_request": { "const": 0 },
          "base_sha": { "const": "" },
          "merge_base_sha": { "const": "" },
          "integration": { "const": "" },
          "policy_change": false
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "report" } },
        "required": ["kind"]
      },
      "else": {
        "properties": { "policy_change": false }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "discovery" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "baseline_digest": { "const": "" },
          "labels_digest": { "const": "" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "baseline" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "baseline_digest": { "const": "" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "reanchor" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "baseline_digest": { "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  ]
}
