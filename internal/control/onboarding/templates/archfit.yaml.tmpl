# Archfit advisory feedback. Generated by the Archfit App; change it only by pull request.
#
# The only step is the Archfit Action, pinned to a commit. It runs the pinned engine image and
# reads the trusted inputs .archfit.yaml, .archfit-baseline.json and .archfit-labels.yaml per file
# from git: on a pull request, each file comes from the pull request head when the pull request
# changes that file, and otherwise from the tip of the base branch; a push or dispatch run reads
# them from the branch it ran on. The App accepts a head copy only when an architecture owner
# approved that exact head commit. The Action fills the upload envelope's baseline_digest and
# labels_digest (bare hex SHA-256, "" when the file is absent) from exactly the files the engine
# read. It uses no repository secret and runs no repository script. Uploads are authenticated with
# the job's GitHub OIDC token (id-token: write).
#
# The Action runs on pull_request, push and workflow_dispatch only and refuses every other event.
# Reports come from pull_request and push runs. A dispatch runs discovery (a proposed policy) or
# baseline (accepted debt as an artifact) on the default branch; discover: true selects discovery.
name: archfit

on:
  pull_request:
  push:
    branches:
      - [[ quote .DefaultBranch ]]
  workflow_dispatch:
    inputs:
      mode:
        description: What a dispatched run does. Reports come from pull_request and push runs, so a dispatch picks discovery or baseline
        type: choice
        options:
          - report
          - discovery
          - baseline
        default: report
      discover:
        description: Propose a policy for review (selects discovery whatever mode says)
        type: boolean
        default: false

permissions:
  contents: read
  id-token: write

jobs:
  archfit:
    runs-on: ubuntu-latest
    steps:
      - uses: alexei-led/archfit-action@[[ .ActionRef ]]
        with:
          endpoint: [[ quote .BaseURL ]]
          audience: [[ quote .BaseURL ]]
          engine-version: [[ quote .EngineVersion ]]
          image-digest: [[ quote .ImageDigest ]]
          mode: ${{ inputs.discover && 'discovery' || inputs.mode }}
          discover: ${{ inputs.discover }}
