# Archfit advisory feedback. Generated by the Archfit App; change it only by pull request.
#
# The only step is the Archfit Action, pinned to a commit. It runs the pinned engine image with
# the base-ref .archfit.yaml, .archfit-baseline.json and .archfit-labels.yaml, and fills the
# upload envelope's baseline_digest and labels_digest (bare hex SHA-256, "" when the file is
# absent) from exactly those files. It uses no repository secret and runs no repository script.
# Uploads are authenticated with the job's GitHub OIDC token (id-token: write).
name: archfit

on:
  pull_request:
  push:
    branches:
      - [[ quote .DefaultBranch ]]
  workflow_dispatch:
    inputs:
      discover:
        description: Propose a policy for review instead of reporting state
        type: boolean
        default: false

permissions:
  contents: read
  id-token: write

jobs:
  archfit:
    runs-on: ubuntu-latest
    steps:
      - uses: alexei-led/archfit-action@[[ .ActionRef ]]
        with:
          endpoint: [[ quote .BaseURL ]]
          audience: [[ quote .BaseURL ]]
          engine-version: [[ quote .EngineVersion ]]
          image-digest: [[ quote .ImageDigest ]]
          discover: ${{ inputs.discover }}
